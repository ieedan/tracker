{
	"name": "tracker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsx --env-file-if-exists=.env scripts/vercel-cron.ts",
		"preview": "vite preview",
		"dev:setup": "tsx scripts/setup.ts",
		"sync": "implement-kit sync",
		"prepare": "implement-kit sync || echo ''",
		"check": "implement-kit sync && tsc --noEmit",
		"ui": "jsrepo add",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1117.0",
		"@aws-sdk/s3-request-presigner": "^3.1117.0",
		"@better-auth/api-key": "^1.7.1",
		"@better-auth/oauth-provider": "1.7.1",
		"@implementjs/core": "~0.0.3",
		"@implementjs/formish": "~0.0.3",
		"@implementjs/lucide": "~0.0.3",
		"@implementjs/mode-watcher": "~0.0.3",
		"@implementjs/primitives": "~0.0.3",
		"@libsql/client": "^0.17.4",
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"nanoid": "^6.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@implementjs/adapter-vercel": "^0.0.11",
		"@implementjs/eslint": "~0.0.1",
		"@implementjs/kit": "~0.0.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@valibot/to-json-schema": "^1.7.1",
		"drizzle-kit": "^0.31.10",
		"jsrepo": "^3.8.1",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^7.3.0"
	}
}
