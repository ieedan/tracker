{
	"name": "tracker",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "implement-kit sync",
		"prepare": "implement-kit sync || echo ''",
		"check": "implement-kit sync && tsc --noEmit",
		"ui": "jsrepo add",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.1",
		"@implementjs/core": "link:../implement/packages/core",
		"@implementjs/formish": "link:../implement/packages/formish",
		"@implementjs/lucide": "link:../implement/packages/lucide",
		"@implementjs/mode-watcher": "link:../implement/packages/mode-watcher",
		"@implementjs/primitives": "link:../implement/packages/primitives",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-image": "^3.30.2",
		"@tiptap/extension-link": "^3.30.2",
		"@tiptap/extension-list": "^3.30.2",
		"@tiptap/extension-placeholder": "^3.30.2",
		"@tiptap/extension-table": "^3.30.2",
		"@tiptap/pm": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"better-auth": "^1.7.1",
		"dompurify": "^3.4.14",
		"drizzle-orm": "^0.45.2",
		"jsdom": "^30.0.1",
		"marked": "^18.0.10",
		"minio": "^8.0.7",
		"octokit": "^5.0.5",
		"pg": "^8.23.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tiptap-markdown": "^0.9.0",
		"valibot": "^1.4.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@implementjs/adapter-node": "link:../implement/packages/adapter-node",
		"@implementjs/kit": "link:../implement/packages/kit",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.10",
		"jsrepo": "^3.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^7.3.0"
	}
}
