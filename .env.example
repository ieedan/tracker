PUBLIC_APP_NAME=tracker
PUBLIC_APP_URL=http://localhost:5173

# --- database (docker compose: postgres) ---
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker

# --- object storage (docker compose: minio) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tracker-uploads
S3_ACCESS_KEY=tracker
S3_SECRET_KEY=trackertracker
# The origin browsers load uploaded files from. Same as S3_ENDPOINT in dev.
S3_PUBLIC_URL=http://localhost:9000

# --- auth ---
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dev only. Enables email+password sign-in for the seeded demo account so the
# app can be used before a GitHub OAuth App exists. Leave false in production.
DEV_LOGIN=false
