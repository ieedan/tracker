# Copy to .env, or let `pnpm setup:dev` fill it in for you.
# For a deployment, `pnpm setup:prod` writes .env.production instead.

PUBLIC_APP_NAME=tracker

# libSQL. A local file in dev; a Turso URL (libsql://...) in production.
DATABASE_URL=file:./local.db
# Only needed for a remote Turso database.
DATABASE_AUTH_TOKEN=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Authorises POST /api/v1/webhooks/drain (webhook retries). Blank closes it.
CRON_SECRET=

# Object storage for attachments. `docker compose up -d` runs MinIO locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tracker-attachments
S3_ACCESS_KEY_ID=tracker
S3_SECRET_ACCESS_KEY=tracker-dev-secret
# Only when the browser reaches storage at a different host than the server does.
S3_PUBLIC_ENDPOINT=

# --- GitHub -----------------------------------------------------------------
# Two separate credentials. The OAuth app signs people in and asks only for
# their identity; leave it blank and the "Sign in with GitHub" button is hidden.
# https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The GitHub App is what reaches repositories. It is installed onto an org by
# someone with authority over it, grants only the repositories they pick, and
# keeps working when that person leaves — which a user's OAuth token does not.
# https://github.com/settings/apps/new
#   Repository permissions: Contents (read), Metadata (read), Pull requests (read)
#   Callback URL: <BETTER_AUTH_URL>/api/v1/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Development only: a personal access token standing in for an installation, so
# the feature can be tried without creating and installing a real App. Ignored
# whenever GITHUB_APP_ID is set.
GITHUB_DEV_TOKEN=

# Point at https://<host>/api/v3 for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com
