# Copy to .env, or let `pnpm setup:dev` fill it in for you.
# For a deployment, `pnpm setup:prod` writes .env.production instead, and
# `pnpm setup:preview` writes .env.preview.

PUBLIC_APP_NAME=tracker

# libSQL. A local file in dev; a Turso URL (libsql://...) in production.
DATABASE_URL=file:./local.db
# Only needed for a remote Turso database.
DATABASE_AUTH_TOKEN=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Extra origins the auth routes accept, comma-separated, beyond BETTER_AUTH_URL.
# Preview builds set this to the hosts that deployment answers on.
BETTER_AUTH_TRUSTED_ORIGINS=

# Authorises POST /api/v1/webhooks/drain (webhook retries). Blank closes it.
CRON_SECRET=

# Object storage for attachments. `docker compose up -d` runs MinIO locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tracker-attachments
S3_ACCESS_KEY_ID=tracker
S3_SECRET_ACCESS_KEY=tracker-dev-secret
# Only when the browser reaches storage at a different host than the server does.
S3_PUBLIC_ENDPOINT=

# --- GitHub -----------------------------------------------------------------
# One GitHub App covers both sign-in and repository access.
# https://github.com/settings/apps/new
#   Callback URLs (both, one per line):
#     <BETTER_AUTH_URL>/api/auth/callback/github
#     <BETTER_AUTH_URL>/api/v1/github/callback
#   Setup URL: <BETTER_AUTH_URL>/api/v1/github/callback
#   Webhook URL: <BETTER_AUTH_URL>/api/v1/github/webhook
#   Subscribe to events: Pull requests
#   Account permissions:    Email addresses (read)
#   Repository permissions: Contents (read), Metadata (read), Pull requests (read)
#
# The App's Client ID (Iv23li...) and a generated client secret. Blank hides the
# "Sign in with GitHub" button. An OAuth app's Ov23li... credentials also work
# here, if you would rather keep sign-in and repository access separate.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The same App, as the installation API identifies it. Installing it onto an org
# is a separate decision from signing in: it is made by someone with authority
# over that org, grants only the repositories they pick, and keeps working when
# that person leaves — which a user's own token does not.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Signs the pull request events GitHub delivers to /api/v1/github/webhook — the
# same string as the App's webhook secret. Those deliveries are what keep a
# linked pull request's state, and the issue's status, right without anybody
# refreshing. Blank refuses every delivery, and the state is instead re-read
# when somebody opens the issue.
GITHUB_APP_WEBHOOK_SECRET=

# Development only: a personal access token standing in for an installation, so
# the feature can be tried without creating and installing a real App. Ignored
# whenever GITHUB_APP_ID is set.
GITHUB_DEV_TOKEN=

# Point at https://<host>/api/v3 for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com

# --- preview deployments ----------------------------------------------------
# Only in .env.preview, and only pushed to Vercel's Preview environment. With
# these set, `scripts/build.ts` gives each preview deployment a database of its
# own, branched from TURSO_PREVIEW_PARENT. `pnpm setup:preview` fills them in.
#
# turso auth api-tokens mint <name> --org <org> --group <group> --full-access
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=
# The migrated, seeded database every preview is copied from.
TURSO_PREVIEW_PARENT=

# The account behind a preview's one-click "Sign in as…" button. Leave both
# blank: the build points it at the account `pnpm db:seed` creates, which is the
# one that is certainly in the copy of TURSO_PREVIEW_PARENT the preview just
# got. Only set these if that template was seeded by something else — and set
# both, since either alone is ignored.
#
# DEMO_LOGIN_EMAIL/DEMO_LOGIN_PASSWORD are what the app itself reads, and the
# build writes them from these. Do not set *those* on Vercel: Vercel applies a
# variable to every environment it is scoped to, so one meant elsewhere would
# name an account no preview database has (ENG-74).
PREVIEW_DEMO_LOGIN_EMAIL=
PREVIEW_DEMO_LOGIN_PASSWORD=
